{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/*.{js,css,svg,png,ico,json,txt}"] },
  "routes": [{ "route": "/config.js", "headers": { "Cache-Control": "no-store" } }],
  "globalHeaders": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" }
}
