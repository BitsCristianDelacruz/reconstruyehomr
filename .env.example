# Public development ports
FRONTEND_PORT=4200
BACKEND_PORT=7071
DATABASE_PORT=5432

# Local relational database (development only)
DATABASE_NAME=reconstruyehome
DATABASE_USER=reconstruye
DATABASE_PASSWORD=change-this-local-password

# Connection consumed by the backend in local containers
DATABASE_URL=postgresql://reconstruye:change-this-local-password@database:5432/reconstruyehome
