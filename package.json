{
  "name": "reconstruyehome",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepositorio de ReconstruyeHome.",
  "scripts": {
    "dev:database": "docker compose up -d --wait database",
    "dev": "docker compose up --build --wait --wait-timeout 240",
    "down": "docker compose down",
    "logs": "docker compose logs -f front back",
    "test": "docker compose exec -T back npm test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build": "docker compose exec -T back npm run build && docker compose exec -T front npm run build"
  }
}
